# Copy to .env and fill in your MySQL Workbench connection details.

PORT=4000

# MySQL (create the schema first with schema.sql, then run `npm run seed`)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=chemquest

# Comma-separated list of origins allowed to call this API with credentials
# (the Vite dev server by default; add your deployed frontend origin too).
CORS_ORIGIN=http://localhost:5173

# Name of the anonymous session cookie. Every visitor (signed in or not)
# gets one of these so gameplay progress is tracked even before/without an
# account.
SESSION_COOKIE_NAME=cq_session
# Cookie lifetime in days.
SESSION_TTL_DAYS=365

# --- Auth (role-based: ADMIN / TEACHER / STUDENT) --------------------------
# Secret used to sign the auth JWT set on /api/auth/login and /signup.
# CHANGE THIS in every real deployment - do not reuse the example value.
JWT_SECRET=ccf6015707b4c41489cedbef2679e3a361e7f1777c4cf9a5a0d570e2b536c129052f76e252dddf3445aa9a67cb6676a4
# Auth cookie lifetime in days.
AUTH_TTL_DAYS=7
# Name of the auth cookie (separate from the anonymous session cookie above).
AUTH_COOKIE_NAME=cq_auth
