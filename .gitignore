# Dependencies
node_modules/

# Build output
# client/dist/ is COMMITTED on purpose: Render's server build step only runs
# `npm ci --omit=dev`, so the prebuilt SPA must ship inside the repo for the
# single-link Express deployment to serve it.
dist/
!client/dist/
!client/dist/**

# Logs
*.log
vite-error.log
server/server.log
server/server.err

# Environment (secrets)
.env
server/.env
*.local

# OS junk
.DS_Store
Thumbs.db

# Stray temp files
/0